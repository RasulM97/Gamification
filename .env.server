# SERVER development mode — loaded ONLY by `vite --mode server`
# (npm run dev:server). Vite loads .env.<mode> files only for the active
# mode: production/demo builds (mode "production") NEVER read this file, so
# these flags can never leak into a shipped bundle. In every build,
# import.meta.env.DEV === false additionally forces the dev-tooling gate off.
VITE_CVE_DATA_MODE=server
VITE_CVE_DEV_TOOLS=true
