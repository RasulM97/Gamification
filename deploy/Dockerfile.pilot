FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY package.json ./
RUN npm install --package-lock=false --legacy-peer-deps --no-audit --no-fund
COPY index.html vite.config.ts tsconfig*.json ./
COPY src ./src
COPY public ./public
COPY backend/app/capacity_policy.json backend/app/seed_events.json ./backend/app/
ENV VITE_CVE_DATA_MODE=server VITE_CVE_DEV_TOOLS=false
RUN npm run build -- --mode server

FROM python:3.12-slim
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini .
COPY --from=frontend /build/dist ./static
ENV CVE_DEV_MODE=false CVE_STATIC_DIR=/app/static CVE_UPLOAD_DIR=/data/uploads
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
